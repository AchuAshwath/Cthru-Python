---
const { entry } = Astro.locals.starlightRoute;
const hero = entry.data.hero || {};
const title = hero.title || entry.data.title;
const tag = hero.tag || "CPython Architecture Guide";
const tagline = hero.tagline || "";
---

<div class="cthru-hero-container w-full flex items-center justify-center py-4 lg:py-0">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-18 items-center w-full max-w-6xl xl:max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Left Column: Copy & Actions (5 cols on lg) -->
    <div class="lg:col-span-5 flex flex-col items-start text-left space-y-6">
      <!-- Eyebrow Tag -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md text-xs font-mono border border-[#1e293b] bg-[#0a0f1d] text-zinc-300 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[#ffd43b]"></span>
        <span>{tag}</span>
      </div>

      <!-- Headline & Tagline with breathing room -->
      <div class="space-y-4">
        <h1 class="text-3xl sm:text-4xl lg:text-[2.65rem] font-semibold tracking-tight text-white leading-[1.18] m-0">
          {title}
        </h1>
        {tagline && (
          <p class="text-zinc-400 text-sm sm:text-base lg:text-[1.05rem] leading-relaxed font-normal m-0 max-w-lg">
            {tagline}
          </p>
        )}
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3.5 pt-2">
        <a
          href="/foundations/mental-model/"
          class="group inline-flex items-center justify-center gap-2 h-9 px-4 py-2 text-sm font-medium rounded-md bg-white text-zinc-950 hover:bg-zinc-200 active:bg-zinc-300 transition-colors shadow-sm no-underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-zinc-400"
        >
          <span>See Through</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="shrink-0 transition-transform group-hover:translate-x-0.5"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>

        <a
          href="https://github.com/AchuAshwath/Cthru-Python"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 h-9 px-4 py-2 text-sm font-medium rounded-md border border-[#1e293b] bg-[#0a0f1d] text-white hover:bg-[#162032] hover:border-[#334155] transition-colors shadow-sm no-underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-zinc-400"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="shrink-0"
          >
            <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"></path>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>

    <!-- Right Column: Terminal Graphic (7 cols on lg) -->
    <div class="lg:col-span-7 flex items-center justify-center w-full">
      <img
        src="/cthru-hero.svg"
        alt="Cthru-Python Visual Architecture"
        class="w-full max-w-[640px] xl:max-w-[720px] max-h-[400px] lg:max-h-[460px] xl:max-h-[500px] object-contain drop-shadow-2xl"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</div>
